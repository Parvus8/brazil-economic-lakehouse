AIRFLOW_UID=50000
# Os segredos abaixo são provisórios: o `make init` troca cada um por um valor aleatório.
# Se criar o .env à mão, gere cada um com `openssl rand -hex 32`.
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_API_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
# Identidades S3 do SeaweedFS: admin é para pessoas; pipeline (bronze, silver e gold) é usada por Airflow, Spark e dbt;
# dashboard só lê o bucket gold
S3_ADMIN_ACCESS_KEY=lakehouse-admin
S3_ADMIN_SECRET_KEY=change-me
S3_PIPELINE_ACCESS_KEY=lakehouse-pipeline
S3_PIPELINE_SECRET_KEY=change-me
S3_DASHBOARD_ACCESS_KEY=lakehouse-dashboard
S3_DASHBOARD_SECRET_KEY=change-me
# Só no Kubernetes: identidade usada pelo Airflow para gravar os logs das tarefas no bucket airflow-logs
S3_LOGS_ACCESS_KEY=airflow-logs
S3_LOGS_SECRET_KEY=change-me
PIPELINE_START_YEAR=2018
# Porta no host para a interface do Airflow (troque se a 8080 já estiver em uso)
AIRFLOW_PORT=8080
# Porta no host para o painel
DASHBOARD_PORT=8501
